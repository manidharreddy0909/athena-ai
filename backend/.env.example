# ============================================================
# Athena AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# ----------------------------------------------------------
# External AI Services (The Only Three Required API Keys)
# ----------------------------------------------------------
# 1. Gemini (Core reasoning and generic generation)
GEMINI_API_KEY=

# 2. BREATH (Persistent memory integration)
BREATH_API_KEY=

# 3. Voice Provider (Speech-to-text / Text-to-speech)
VOICE_API_KEY=

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://athena:athena_secret@localhost:5432/athena_db

# ----------------------------------------------------------
# Qdrant Vector Database
# ----------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ----------------------------------------------------------
# Redis
# ----------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------
# App Settings
# ----------------------------------------------------------
APP_NAME=Athena AI
APP_VERSION=1.0.0
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----------------------------------------------------------
# Interview Settings
# ----------------------------------------------------------
MIN_QUESTIONS=8
MIN_CURRICULUM_DAYS=4
MAX_QUESTIONS=15
SESSION_TIMEOUT_MINUTES=60
