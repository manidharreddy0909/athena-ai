# ============================================================
# Athena AI — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# ----------------------------------------------------------
# LLM Provider (pick one — all are OpenAI-compatible)
# ----------------------------------------------------------
# Option 1: OpenRouter (access Claude, GPT-4o, Gemini, etc.)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-your-new-key-here
LLM_MODEL=anthropic/claude-3.5-sonnet

# Option 2: LM Studio (local, free, offline)
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=gemma-4-or-whatever-you-loaded

# Option 3: Groq (free tier, very fast)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your-groq-key
# LLM_MODEL=llama-3.3-70b-versatile

# Option 4: Direct OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-key
# LLM_MODEL=gpt-4o

# ----------------------------------------------------------
# Embedding Model (for Qdrant semantic memory)
# ----------------------------------------------------------
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=sk-or-v1-your-new-key-here
EMBEDDING_MODEL=openai/text-embedding-3-small

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://athena:athena_secret@localhost:5432/athena_db

# ----------------------------------------------------------
# Qdrant Vector Database
# ----------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# For Qdrant Cloud: set QDRANT_URL=https://xxx.qdrant.io and QDRANT_API_KEY=your-key

# ----------------------------------------------------------
# Redis
# ----------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------
# App Settings
# ----------------------------------------------------------
APP_NAME=Athena AI
APP_VERSION=1.0.0
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Interview Settings
MIN_QUESTIONS=8
MIN_CURRICULUM_DAYS=4
MAX_QUESTIONS=15
SESSION_TIMEOUT_MINUTES=60
